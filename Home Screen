INCLUDE flappy.inc

.code
main PROC
call Randomize
MenuLoop :
call ShowHomeScreen
MenuInput :
call ReadChar
cmp  al, ' '
je   StartGame
cmp  al, 'q'
je   QuitProgram
cmp  al, 'Q'
je   QuitProgram
jmp  MenuInput
StartGame :
call RunGame
call EndRound
jmp  MenuLoop
QuitProgram :
call Clrscr
exit
main ENDP

ShowHomeScreen PROC USES eax
call Clrscr
mGotoxy 12, 5
mWrite "FLAPPY BIRD"
mGotoxy 12, 8
mWrite "[Space] Play"
mGotoxy 12, 9
mWrite "[Q] Quit"
mGotoxy 12, 11
mWrite "High Score: "
mov  eax, HighScore
call WriteDec
ret
ShowHomeScreen ENDP


UpdateScore PROC USES eax ebx ecx
mov  ebx, 0
ScoreLoop:
cmp  ebx, NUM_TOWERS
jge  ScoreDone
cmp  PassTower[ebx * 4], 1
je   ScoreNext
mov  eax, TowerX[ebx * 4]
add  eax, TowerWidth
movzx ecx, birdX
cmp  eax, ecx
jg   ScoreNext
mov  PassTower[ebx * 4], 1
inc  CurrScore
ScoreNext :
inc  ebx
jmp  ScoreLoop
ScoreDone :
ret
UpdateScore ENDP

ShowScore PROC USES eax
mGotoxy 0, MAP_HEIGHT
mWrite "Score: "
mov  eax, CurrScore
call WriteDec
ret
ShowScore ENDP

EndRound PROC USES eax
mov  eax, CurrScore
cmp  eax, HighScore
jbe  ShowResults
mov  HighScore, eax
ShowResults :
call Clrscr
mGotoxy 12, 7
mWrite "GAME OVER"
mGotoxy 12, 9
mWrite "Score: "
mov  eax, CurrScore
call WriteDec
mGotoxy 12, 10
mWrite "High Score: "
mov  eax, HighScore
call WriteDec
mGotoxy 6, 13
mWrite "Press Enter to continue"
WaitEnter:
call ReadChar
cmp  al, 0Dh
jne  WaitEnter
ret
EndRound ENDP

END main
