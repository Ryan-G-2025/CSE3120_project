INCLUDE Irvine32.inc

;Map functions and dimensions  being declared
MAP_WIDTH = 36
MAP_HEIGHT = 20
GROUND_ROW = 19

.data 

TowerWidth DWORD 3
TowerMove DWORD 1
TowerX DWORD 35, 50, 65
TopGap DWORD 6, 8, 5
BottomGap DWORD 13, 15, 12
NewTowerX DWORD 0

;Game state stuff
PassTower DWORD 0, 0, 0
CurrScore DWORD 0
HighScore DWORD 0 
GameActive DWORD 1

;rendering variables
CellRow DWORD 0
CellCol DWORD 0
TowerInd DWORD 0

;mechanics stuff
GameOverTxt BYTE "GAME OVER", 0
ScoreTxt BYTE "Score: ", 0
HighScoreTxt BYTE "High Score: ", 0


.code
;Intialize map parts and score
MapInitialize PROC
  mov TowerX, 35
  mov TowerX[4], 50
  mov TowerX[8], 65
  mov CurrScore, 0
  mov HighScore, 0
  mov PassTower, 0
  mov PassTower[4], 0
  mov PassTower[8], 0
  mov GameActive, 1

  ret
MapInitialize ENDP

;Move the tower down the map as player continues
MoveTower PROC
  mov TowerInd, 0

MoveTLoop: 
  cmp TowerInd, 3
  mov ebx, TowerInd

  mov eax, TowerMove
  sub TowerX[ebx*4], eax
  inc TowerInd

  ret

MoveTower ENDP

;Generate the Towers
CreateTower PROC
  mov TowerInd, 0

CreateLoop:
  cmp TowerInd, 3
  jge CreateDone
  mov ebx, TowerInd
  cmp TowerX[ebx*4], -3
  jg CreateNext

  mov eax, TowerX[0]
  cmp eax, TowerX[4]
  jge CheckThird
  mov eax, TowerX[4]

CheckThird:
  cmp eax, TowerX[8]
  jge PlaceTower
  mov eax, TowerX[8]

PlaceTower:
  add eax, 15
  mov TowerX[ebx*4], eax

  ;make gap in towers dif
  mov eax, 6
  add eax, 4
  mov TopGap[ebx*4], eax

  add eax, 7
  mov BottomGap[ebx*4], eax
  mov PassTower[ebx*4], 0

CreateNext:
  inc TowerInd
  jmp CreateLoop

CreateDone: 
  ret
CreateTower ENDP





