This file is for the movement of the controllable charecter. 
This will contain the positional data, storing the x and y cords
This will also create and display the controllable character.

The flappy bird dysplay:
movement in x:
  will be a constant speed moving to the right
movement in y:
  if the player presses space, it will make the flappy bird jump up some pixles before gravity takes over
  will always have a gravity make the flappy bird fall to the ground exept when the jump key is pressed

if time: make a little animation for the jumping
if the bird is jumping, rotate the model so it tilts up
if the bird is falling, rotate the model down

INCLUDE flappy.inc

BIRD_CHAR = '>'
FRAME_DELAY = 100
GRAVITY_RATE = 1
JUMP_HEIGHT = 4
SPACE_KEY = ' '
ESC_KEY = 1Bh

.data
birdX      BYTE 10
birdY      BYTE 10
birdVel    SBYTE 0
frameCount BYTE 0
quitGame   BYTE 0

.code
RunGame PROC
call MapInitialize
mov  birdY, 10
mov  quitGame, 0
call Clrscr
GameLoop :
call CheckInput
cmp  quitGame, 1
je   EndGame
call UpdateBird
call MoveTower
call CreateTower
call CheckCollision
cmp  GameActive, 0
je   EndGame
call CreateMap
call DrawBird
mov  eax, FRAME_DELAY
call Delay
jmp  GameLoop
EndGame :
ret
RunGame ENDP

; NOT LEARNED IN CLASS : learned from Irvine book regaurding read key
CheckInput PROC USES eax ebx edx
call ReadKey
jz   InputDone
cmp  al, ESC_KEY
jne  CheckSpace
mov  quitGame, 1
jmp  InputDone
CheckSpace :
cmp  al, SPACE_KEY
jne  InputDone
cmp  birdY, JUMP_HEIGHT
jb   HitCeiling
sub  birdY, JUMP_HEIGHT
jmp  InputDone
HitCeiling :
mov  birdY, 0
InputDone :
    ret
    CheckInput ENDP

    UpdateBird PROC
    inc  frameCount
    cmp  frameCount, GRAVITY_RATE
    jb   UpdateDone
    mov  frameCount, 0
    cmp  birdY, GROUND_ROW
    jae  UpdateDone
    inc  birdY
    UpdateDone :
ret
UpdateBird ENDP

DrawBird PROC USES eax edx
mov  dl, birdX
mov  dh, birdY
call Gotoxy
mov  al, BIRD_CHAR
call WriteChar
ret
DrawBird ENDP


END 
