This file is for the movement of the controllable charecter. 
This will contain the positional data, storing the x and y cords
This will also create and display the controllable character.

The flappy bird dysplay:
movement in x:
  will be a constant speed moving to the right
movement in y:
  if the player presses space, it will make the flappy bird jump up some pixles before gravity takes over
  will always have a gravity make the flappy bird fall to the ground exept when the jump key is pressed

if time: make a little animation for the jumping
if the bird is jumping, rotate the model so it tilts up
if the bird is falling, rotate the model down

INCLUDE Irvine32.inc

GROUND_ROW = 20
BIRD_CHAR = '>'
FRAME_DELAY = 100
GRAVITY_RATE = 2

.data
birdX      BYTE 10
birdY      BYTE 10
birdVel    SBYTE 0
frameCount BYTE 0

.code
main PROC
call Clrscr
GameLoop :
call EraseBird
call UpdateBird
call DrawBird
mov  eax, FRAME_DELAY
call Delay
jmp  GameLoop
exit
main ENDP

UpdateBird PROC
inc  frameCount
cmp  frameCount, GRAVITY_RATE
jb   UpdateDone
mov  frameCount, 0
cmp  birdY, GROUND_ROW
jae  UpdateDone
inc  birdY
UpdateDone :
ret
UpdateBird ENDP

DrawBird PROC USES eax edx
mov  dl, birdX
mov  dh, birdY
call Gotoxy
mov  al, BIRD_CHAR
call WriteChar
ret
DrawBird ENDP

EraseBird PROC USES eax edx
mov  dl, birdX
mov  dh, birdY
call Gotoxy
mov  al, ' '
call WriteChar
ret
EraseBird ENDP

END main
